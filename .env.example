# Set these as environment variables before starting Weather99.
# This file is a template; the application does not auto-load .env files.
QWEATHER_API_HOST=your-api-host.qweatherapi.com

# Configure exactly one authentication method. Do not place credentials in URLs.
# Preferred: a valid JWT supplied/refreshed by your calling environment.
QWEATHER_JWT=
# Alternative authentication; leave empty when using JWT.
QWEATHER_API_KEY=
